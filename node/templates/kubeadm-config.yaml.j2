---
apiVersion: kubeadm.k8s.io/v1beta4
discovery:
  bootstrapToken:
    apiServerEndpoint: {{ kubernetes_api_server_address | default (hostvars[groups['master'] | random(seed=inventory_hostname)].apiserver_local_address | default(hostvars[groups['master'] | random(seed=inventory_hostname)].ansible_facts.default_ipv4.address)) }}:{{ kubernetes_api_server_port | default(kubernetes_api_endpoint_port) }}
    token: {{ kubeadm_token.stdout }}
    caCertHashes:
    - "sha256:{{ kubeadm_ca_hash.stdout }}"
  tlsBootstrapToken: {{ kubeadm_token.stdout }}
kind: JoinConfiguration
nodeRegistration:
  criSocket: {{ cri_socket }}
{% if kubeadm_kubelet_extra_args %}
  kubeletExtraArgs:
{% set args = (kubeadm_kubelet_extra_args | from_yaml) if kubeadm_kubelet_extra_args is string else kubeadm_kubelet_extra_args %}
{% set args = (args | dict2items(key_name='name', value_name='value')) if args is mapping else args %}
{% for arg in args %}
  - name: {{ arg.name | to_json }}
    value: {{ arg.value | string | to_json }}
{% endfor %}
{% endif %}
